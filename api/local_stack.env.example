# Public API
REFINE_API_HOST=0.0.0.0
REFINE_API_PORT=10083
REFINE_API_PYTHON=/opt/venv/bin/python

# Internal localhost services
USE_REMOTE_SERVICES=1
AUTO_START_LOCAL_SERVICES=1
AUTO_START_HUNYUAN=1
AUTO_START_ULTRASHAPE=1
LOCAL_SERVICE_START_TIMEOUT=180

HUNYUAN_SERVICE_URLS=http://127.0.0.1:9084
ULTRASHAPE_SERVICE_URLS=http://127.0.0.1:9085

# GPU slot mapping
HUNYUAN_CUDA_VISIBLE_DEVICES_LIST=0
ULTRASHAPE_CUDA_VISIBLE_DEVICES_LIST=0

# Project-local model caches
HUNYUAN_ROOT=/workspace/ultrashape/Hunyuan3D-2.1
HUNYUAN_CACHE_DIR=/workspace/ultrashape/Hunyuan3D-2.1/cache
ULTRASHAPE_CACHE_DIR=/workspace/ultrashape/UltraShape-1.0/cache
ULTRASHAPE_OSS_BUCKET=kokokoni
ULTRASHAPE_OSS_PREFIX=docker-input&output/kokoni-shape
ULTRASHAPE_OSS_SIGN_EXPIRES=24h
ULTRASHAPE_TMP_ROOT=/tmp/ultrashape-oss-workspace
ULTRASHAPE_DINO_MODEL=facebook/dinov2-large
ULTRASHAPE_DINO_LOCAL_DIR=/workspace/ultrashape/UltraShape-1.0/cache/pretrained/facebook--dinov2-large
ULTRASHAPE_PREFETCH_DINO_ON_STARTUP=1

# Optional: override the interpreter for the internal services.
# For the single-venv Docker layout, keep both on the same /opt/venv.
HUNYUAN_SERVICE_PYTHON=/opt/venv/bin/python
ULTRASHAPE_SERVICE_PYTHON=/opt/venv/bin/python

# Optional runtime tuning
SERVICE_TIMEOUT=1200
TASK_QUEUE_MAXSIZE=2
KEEP_INTERMEDIATE=0
# For service deployment, keep startup lightweight and lazy-load on first request.
HUNYUAN_LOAD_ON_STARTUP=0
ULTRASHAPE_LOAD_ON_STARTUP=0
HUNYUAN_POST_ACTION=none
ULTRASHAPE_POST_ACTION=none
MEMORY_ACTION_TIMEOUT=120
HUNYUAN_STAGED_EXPORT=1
ULTRASHAPE_STAGED_EXPORT=1
