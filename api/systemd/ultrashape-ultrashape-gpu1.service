[Unit]
Description=UltraShape Refine Service (GPU 1, port 9087)
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/ultrashape/ultrashape.env
Environment=ULTRASHAPE_ENV=ultrashape
Environment=ULTRASHAPE_CUDA_VISIBLE_DEVICES=1
Environment=ULTRASHAPE_SERVICE_HOST=0.0.0.0
Environment=ULTRASHAPE_SERVICE_PORT=9087
WorkingDirectory=__ULTRASHAPE_ROOT__
ExecStart=/bin/bash -c 'set -e; if [ -n "${CONDA_SH:-}" ]; then source "${CONDA_SH}"; conda activate "${ULTRASHAPE_ENV}"; fi; exec "${PYTHON_BIN:-python3}" "${ULTRASHAPE_ROOT}/api/ultrashape_server.py"'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
