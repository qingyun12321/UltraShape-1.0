# Optional overrides for systemd services.
# WORKSPACE_ROOT should be the parent directory that contains:
# - UltraShape-1.0
# - Hunyuan3D-2.1
WORKSPACE_ROOT=__WORKSPACE_ROOT__
HUNYUAN_ROOT=__WORKSPACE_ROOT__/Hunyuan3D-2.1
ULTRASHAPE_ROOT=__WORKSPACE_ROOT__/UltraShape-1.0

# If you use conda, set CONDA_SH to your conda.sh path.
# Example: /opt/conda/etc/profile.d/conda.sh
CONDA_SH=__CONDA_SH__
HUNYUAN_ENV=anta3d
ULTRASHAPE_ENV=ultrashape
PYTHON_BIN=python3

# Hunyuan runtime behavior
HUNYUAN_LOAD_ON_STARTUP=1
HUNYUAN_STAGED_EXPORT=1
HUNYUAN_IDLE_OFFLOAD_SECS=60
HUNYUAN_KEEP_ON_GPU=model,conditioner
HUNYUAN_POST_ACTION=unload

# UltraShape runtime behavior
ULTRASHAPE_LOAD_ON_STARTUP=1
ULTRASHAPE_LAZY_REMBG=1
ULTRASHAPE_STAGED_EXPORT=1
ULTRASHAPE_IDLE_OFFLOAD_SECS=60
ULTRASHAPE_KEEP_ON_GPU=model,conditioner
ULTRASHAPE_POST_ACTION=offload
MEMORY_ACTION_TIMEOUT=120
